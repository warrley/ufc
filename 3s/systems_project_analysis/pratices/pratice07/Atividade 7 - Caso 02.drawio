        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor white\nactor Discente\nboundary \&quot;Interface do SIGAA\&quot; as UI\ncontrol \&quot;Controlador de Dados Pessoais\&quot; as Ctrl\nentity \&quot;Serviço de Discente\&quot; as Servico\n\nDiscente -&gt; UI: seleciona \&quot;Meus dados pessoais\&quot;\nUI -&gt; Ctrl: carregarDadosPessoais(idDiscente)\nCtrl -&gt; Servico: obterDados(idDiscente)\nServico --&gt; Ctrl: dados atuais\nCtrl --&gt; UI: exibe dados (abas)\nUI --&gt; Discente: dados\n\nDiscente -&gt; UI: realiza alterações nos campos\nDiscente -&gt; UI: clica \&quot;Confirmar\&quot;\nUI -&gt; Ctrl: confirmarAlteracoes(dadosEditados)\nCtrl -&gt; UI: solicitarSenha()\nUI --&gt; Discente: exibe campo de senha\nDiscente -&gt; UI: insere senha\nUI -&gt; Ctrl: validarSenha(senha)\nCtrl -&gt; Servico: validarSenha(idDiscente, senha)\nServico --&gt; Ctrl: senha válida\nCtrl -&gt; Servico: salvarAlteracoes(idDiscente, dadosEditados)\nServico --&gt; Ctrl: sucesso\nCtrl --&gt; UI: mensagem \&quot;Dados atualizados com êxito\&quot;\nUI --&gt; Discente: exibe sucesso\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="ei4xLunbwceMDKW6u3jN-2">
